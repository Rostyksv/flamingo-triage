{
  "name": "flamingo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run prisma:push && npm run db:seed",
    "verify:r1": "tsx scripts/verify-r1-concurrency.ts",
    "verify:r2": "tsx scripts/verify-r2-authorization.ts",
    "verify:r3": "tsx scripts/verify-r3-notifications.ts",
    "verify:r5": "tsx scripts/verify-r5-sweep.ts",
    "verify:all": "npm run verify:r1 && npm run verify:r2 && npm run verify:r3 && npm run verify:r5",
    "notifications:run": "tsx scripts/run-notifications.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
