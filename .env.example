# Connect to Postgres via the shared transaction-mode pooler (pgBouncer, port 6543)
DATABASE_URL="postgresql://<username>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Direct session-mode connection for migrations (port 5432, optional with db push)
DIRECT_URL="postgresql://<username>:<password>@<host>:5432/postgres"

# HMAC secret for the seeded-login cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Secret that protects the /api/sweep/run cron endpoint.
# Vercel Cron automatically sends Authorization: Bearer ${CRON_SECRET}.
CRON_SECRET="replace-with-a-long-random-string"
